---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProductMark from '../components/ProductMark.astro';
import QuoteCard from '../components/QuoteCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Customers" description={`What controllers, CFOs, CPAs, valuators, and M&A professionals say about Ledgerline — ${site.stats.rating}/5 from verified reviews from ${site.stats.reviews} reviews.`}>
  <PageHero
    crumbs={[{ label: 'Company' }, { label: 'Customers' }]}
    eyebrow="Customers"
    heading="In their own words."
    lede="Controllers, CFOs, CPAs, valuators, and deal professionals on what changed when they stopped fighting the tool and started owning the numbers."
  >
    <dl slot="aside" class="figs">
      <div><dt>Customer rating</dt><dd class="figure-num">{site.stats.rating}<small>/5</small></dd></div>
      <div><dt>Reviews</dt><dd class="figure-num">{site.stats.reviews}</dd></div>
      <div><dt>Annual renewal</dt><dd class="figure-num">{site.stats.renewal}</dd></div>
      <div><dt>Since</dt><dd class="figure-num">{site.founded}</dd></div>
    </dl>
  </PageHero>

  <nav class="container jump" aria-label="Jump to product">
    {
      products.map((p) => (
        <a href={`#${p.id}`}>
          <ProductMark slug={p.id} size="sm" /> {p.data.name}
        </a>
      ))
    }
  </nav>

  {
    products.map((p, i) => (
      <section id={p.id} class:list={['section', { 'surface-alt': i % 2 === 0 }]} style={`--hue: ${p.data.hue}`} aria-labelledby={`${p.id}-h`}>
        <div class="container">
          <header class="group-head">
            <ProductMark slug={p.id} size="lg" />
            <div>
              <p class="tag">{p.data.category}</p>
              <h2 id={`${p.id}-h`}>{p.data.name}</h2>
            </div>
            <a class="text-link" href={`/${p.id}/`}>
              Explore {p.data.name} <span aria-hidden="true">→</span>
            </a>
          </header>
          <div class="quotes">
            {p.data.proof.testimonials.map((t) => (
              <QuoteCard {...t} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <CtaBand heading="Become the next *long-time customer*." body="Many of our customers have relied on the same product for over a decade." />
</BaseLayout>

<style>
  .figs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: rgba(14, 20, 32, 0.7);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    overflow: hidden;
  }
  .figs div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
    padding: var(--space-m);
    border-bottom: 1px solid var(--rule-soft);
  }
  .figs div:nth-child(2n) { border-left: 1px solid var(--rule); }
  .figs dd { margin: 0; font-size: var(--step-3); font-weight: 800; line-height: 1; color: #ffffff; }
  .figs small { font-size: 0.55em; color: var(--accent); }
  .figs dt { font-size: var(--step--2); color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; font-family: var(--font-mono); }

  .jump { display: flex; flex-wrap: wrap; gap: 0.5rem; padding-block: var(--space-m); }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem 0.45rem 0.45rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 600;
    background: rgba(14, 20, 32, 0.8);
    backdrop-filter: blur(8px);
    color: var(--ink);
    transition: all 0.2s var(--ease);
  }
  .jump a:hover {
    border-color: rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .group-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-m);
    align-items: center;
    padding-bottom: var(--space-m);
    margin-bottom: var(--space-l);
    border-bottom: 1px solid var(--rule);
  }
  .group-head .text-link { grid-column: 1 / -1; justify-self: start; }
  @media (min-width: 48rem) { .group-head { grid-template-columns: auto 1fr auto; } .group-head .text-link { grid-column: auto; } }
  .group-head h2 { font-size: var(--step-3); font-weight: 700; color: #ffffff; }
  .quotes { columns: 1; column-gap: var(--space-m); }
  .quotes > :global(*) { margin-bottom: var(--space-m); }
  @media (min-width: 44rem) { .quotes { columns: 2; } }
  @media (min-width: 70rem) { .quotes { columns: 3; } }
</style>
