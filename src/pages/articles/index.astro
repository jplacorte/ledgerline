---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { formatMonth } from '../../lib/text';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.data.readingMinutes - a.data.readingMinutes,
);
const [lead, ...rest] = posts;
const hueFor = async (ref: (typeof posts)[number]['data']['product']) => (ref ? (await getEntry(ref))?.data.hue : undefined) ?? 'var(--accent)';
const hues = Object.fromEntries(await Promise.all(posts.map(async (p) => [p.id, await hueFor(p.data.product)])));
---

<BaseLayout title="Articles" description="Analysis for financial professionals — fixed assets, business valuation, M&A, and getting beyond spreadsheets.">
  <PageHero crumbs={[{ label: 'Articles' }]} eyebrow="Articles" heading="Short, sharp reads *on the numbers*." lede="Practical analysis for controllers, CFOs, CPAs, valuators, and deal professionals." />

  <section class="section">
    <div class="container">
      {
        lead && (
          <article class="lead" style={`--hue: ${hues[lead.id]}`}>
            <a href={`/articles/${lead.id}/`} class="lead-img">
              <Image src={lead.data.cover} alt={lead.data.coverAlt} widths={[640, 960, 1200]} sizes="(min-width: 60rem) 700px, 100vw" loading="eager" />
            </a>
            <div class="lead-body">
              <p class="tag"><span class="dot" />{lead.data.category}</p>
              <h2><a href={`/articles/${lead.id}/`}>{lead.data.title}</a></h2>
              <p class="lede">{lead.data.description}</p>
              <p class="meta mono">{formatMonth(lead.data.pubDate)} · {lead.data.readingMinutes} min read</p>
            </div>
          </article>
        )
      }
      <ul class="grid" role="list">
        {
          rest.map((post) => (
            <li>
              <article class="card" style={`--hue: ${hues[post.id]}`}>
                <a href={`/articles/${post.id}/`} class="card-img" tabindex="-1" aria-hidden="true">
                  <Image src={post.data.cover} alt="" widths={[480, 720]} sizes="(min-width: 60rem) 400px, 100vw" />
                </a>
                <p class="tag"><span class="dot" />{post.data.category}</p>
                <h3><a href={`/articles/${post.id}/`}>{post.data.title}</a></h3>
                <p class="desc">{post.data.description}</p>
                <p class="meta mono">{formatMonth(post.data.pubDate)} · {post.data.readingMinutes} min read</p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand heading="Ready to *own your numbers*?" body="See how Ledgerline fits the work you do." />
</BaseLayout>

<style>
  .lead {
    display: grid;
    gap: var(--space-l);
    align-items: center;
    padding: var(--space-xl);
    background: var(--card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-l);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .lead:hover {
    border-color: var(--border-bright);
    box-shadow: 0 8px 32px rgba(0, 240, 160, 0.08);
  }
  @media (min-width: 60rem) { .lead { grid-template-columns: 1.2fr 1fr; gap: var(--space-xl); } }
  .lead-img, .card-img {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: #04060a;
  }
  .lead-img :global(img), .card-img :global(img) {
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .lead:hover .lead-img :global(img), .card:hover .card-img :global(img) { transform: scale(1.03); }
  .lead-body { display: grid; gap: var(--space-s); }
  .lead h2 { font-size: var(--step-3); }
  h2 a, h3 a { text-decoration: none; color: var(--ink); transition: color 0.2s var(--ease); }
  h2 a:hover, h3 a:hover { color: var(--accent); }
  .meta { font-size: var(--step--2); color: var(--muted); }
  .grid { display: grid; gap: var(--space-m); margin-top: var(--space-xl); }
  @media (min-width: 48rem) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 72rem) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .card {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    padding: var(--space-l);
    background: var(--card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-l);
    height: 100%;
    transition: transform 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: var(--border-bright);
  }
  .card h3 { font-size: var(--step-1); }
  .desc { color: var(--ink-2); font-size: var(--step--1); line-height: 1.5; }
</style>
