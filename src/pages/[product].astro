---
import { getCollection, getEntries, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductMark from '../components/ProductMark.astro';
import ScreenPlate from '../components/ScreenPlate.astro';
import type { Props as MockProps } from '../components/MockScreen.astro';
import SectionHeader from '../components/SectionHeader.astro';
import QuoteCard from '../components/QuoteCard.astro';
import PricingCard from '../components/PricingCard.astro';
import FaqList from '../components/FaqList.astro';
import DesktopByDesign from '../components/DesktopByDesign.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { buyHref, site } from '../data/site';
import { emph, plain } from '../lib/text';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({ params: { product: product.id }, props: { product } }));
}

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const p = product.data;
const slug = product.id;
const related = await getEntries(p.related);

const withImages = p.capabilities.items.filter((i) => i.screen);
const withoutImages = p.capabilities.items.filter((i) => !i.screen);
let fig = 1;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: p.name,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Windows 10, Windows 11',
    description: p.seo.description,
    publisher: { '@type': 'Organization', name: site.name },
    offers: p.pricing.plans
      .filter((plan) => plan.price.startsWith('$'))
      .map((plan) => ({
        '@type': 'Offer',
        name: plan.name,
        price: plan.price.replace(/[$,]/g, ''),
        priceCurrency: 'USD',
      })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: p.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={p.seo.title.split(' — ')[0]} description={p.seo.description} jsonLd={jsonLd} hue={p.hue}>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Products', href: '/#products' }, { label: p.name }]} />
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker">
            <ProductMark slug={slug} size="lg" />
            <span>
              <span class="hero-name">{p.name}</span>
              <span class="tag">{p.category}</span>
            </span>
          </p>
          <h1 set:html={emph(p.headline)} />
          <p class="lede">{p.summary}</p>
          <div class="btn-row hero-actions">
            <a class="btn btn-accent" href={buyHref(slug)}>Buy — from {p.fromPrice} <span class="arrow" aria-hidden="true">→</span></a>
            <a class="btn btn-ghost" href={p.secondaryCta?.href ?? `/book-a-demo/?product=${slug}`}>{p.secondaryCta?.label ?? 'Book a demo'}</a>
          </div>
          <p class="hero-note mono">{p.priceNote} · 30-day money-back guarantee</p>
          <p class="audience">{p.forWho}</p>
        </div>
        <div class="hero-plate">
          <ScreenPlate screen={p.hero.screen as MockProps} caption={p.hero.caption} label={`Fig. ${fig++}`} title={`${p.name} — ${p.hero.caption.split(' — ')[0]}`} />
        </div>
      </div>
      <dl class="stat-strip">
        {
          p.stats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd class="figure-num">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Proof -->
  <section class="section surface-alt" aria-labelledby="proof-h">
    <div class="container">
      <SectionHeader id="proof-h" eyebrow="What customers say" num="01" heading={p.proof.heading}>
        <p class="rating mono">★ {site.stats.rating}/5 · {site.stats.reviews} verified reviews · {site.stats.years} years in business</p>
      </SectionHeader>
      <div class="quotes">
        {p.proof.testimonials.map((t) => <QuoteCard {...t} />)}
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="section" aria-labelledby="problem-h">
    <div class="container split">
      <div>
        <SectionHeader id="problem-h" eyebrow={p.problem.eyebrow} num="02" heading={p.problem.heading} />
        <div class="stack prose-sm">
          {p.problem.body.map((para) => <p>{para}</p>)}
        </div>
      </div>
      <div class="problem-side">
        {
          p.problem.compare && (
            <table class="ledger">
              <caption class="sr-only">Before and after {p.name}</caption>
              <thead>
                <tr>
                  <th scope="col"><span class="neg">✕</span> Without {p.name}</th>
                  <th scope="col"><span class="pos">✓</span> With {p.name}</th>
                </tr>
              </thead>
              <tbody>
                {p.problem.compare.without.map((w, i) => (
                  <tr>
                    <td>{w}</td>
                    <td>{p.problem.compare?.with[i]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
        {p.problem.quote && <QuoteCard {...p.problem.quote} size="lg" />}
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section surface-card ruled-top" aria-labelledby="cap-h">
    <div class="container">
      <SectionHeader id="cap-h" eyebrow={p.capabilities.eyebrow} num="03" heading={p.capabilities.heading} intro={p.capabilities.intro} />
      <div class="features">
        {
          withImages.map((item, i) => (
            <article class:list={['feature', { flip: i % 2 === 1 }]}>
              <div class="feature-copy">
                <p class="kicker mono">{item.kicker}</p>
                <h3>{item.title}</h3>
                {item.body.map((para) => <p>{para}</p>)}
                {item.bullets && <ul class="checks">{item.bullets.map((b) => <li>{b}</li>)}</ul>}
                {item.figure && (
                  <p class="feature-figure">
                    <span class="figure-num">{item.figure.value}</span>
                    <span>{item.figure.label}</span>
                  </p>
                )}
              </div>
              <div class="feature-plate reveal">
                <ScreenPlate screen={item.screen as MockProps} caption={item.caption} label={`Fig. ${fig++}`} title={`${p.name} — ${item.kicker.split(' · ').pop()}`} />
              </div>
            </article>
          ))
        }
      </div>
      {
        withoutImages.length > 0 && (
          <div class="feature-cards">
            {withoutImages.map((item) => (
              <article class="feature-card">
                <p class="kicker mono">{item.kicker}</p>
                <h3>{item.title}</h3>
                {item.figure && <p class="card-figure figure-num">{item.figure.value}</p>}
                {item.body.map((para) => <p>{para}</p>)}
                {item.bullets && <ul class="checks">{item.bullets.map((b) => <li>{b}</li>)}</ul>}
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>

  {
    p.questions && (
      <section class="section surface-night" aria-labelledby="q-h">
        <div class="container">
          <SectionHeader id="q-h" eyebrow="What it surfaces" heading={p.questions.heading} intro={p.questions.intro} />
          <ol class="questions" role="list">
            {p.questions.items.map((q, i) => (
              <li>
                <span class="qn mono">{String(i + 1).padStart(2, '0')}</span>
                <span>{q}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    p.steps && (
      <section class="section surface-alt" aria-labelledby="steps-h">
        <div class="container">
          <SectionHeader id="steps-h" eyebrow={p.steps.eyebrow} num="04" heading={p.steps.heading} intro={p.steps.intro} />
          <ol class="steps" role="list">
            {p.steps.items.map((s, i) => (
              <li class="step reveal">
                <span class="step-n mono">{String(i + 1).padStart(2, '0')}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <!-- Audience -->
  <section class="section" aria-labelledby="aud-h">
    <div class="container">
      <SectionHeader id="aud-h" eyebrow={p.audience.eyebrow} num="05" heading={p.audience.heading} intro={p.audience.intro} />
      <div class="audience-grid">
        {
          p.audience.items.map((a) => (
            <article class="aud">
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </article>
          ))
        }
      </div>
      {
        p.audience.note && (
          <aside class="note">
            <div>
              <h3>{p.audience.note.title}</h3>
              <p>{p.audience.note.body}</p>
            </div>
            <a class="text-link" href={p.audience.note.href}>
              {p.audience.note.label} <span aria-hidden="true">→</span>
            </a>
          </aside>
        )
      }
    </div>
  </section>

  <!-- Pricing -->
  <section class="section surface-alt" id="pricing" aria-labelledby="pricing-h">
    <div class="container">
      <SectionHeader id="pricing-h" eyebrow="Pricing" num="06" heading={p.pricing.heading} intro={p.pricing.intro} />
      <div class:list={['plans', `n${p.pricing.plans.length}`]}>
        {p.pricing.plans.map((plan) => <PricingCard productSlug={slug} plan={plan} />)}
        {
          p.pricing.includes && (
            <div class="includes">
              <p class="kicker mono">Every subscription includes</p>
              {p.pricing.includes.map((inc) => (
                <div>
                  <h3>{inc.title}</h3>
                  <p>{inc.body}</p>
                </div>
              ))}
            </div>
          )
        }
      </div>
      <aside class="guarantee">
        <span class="seal mono" aria-hidden="true">30<small>DAY</small></span>
        <div>
          <h3>30-day money-back guarantee</h3>
          <p>{p.pricing.guarantee}</p>
        </div>
      </aside>
    </div>
  </section>

  {
    p.sample && (
      <section class="section-tight sample">
        <div class="container sample-inner">
          <div class="doc" aria-hidden="true">
            <span class="doc-brand">{site.name}</span>
            <span class="doc-title">{p.name}</span>
            <span class="doc-lines"><i /><i /><i /><i /><i /></span>
            <span class="doc-foot mono">Editable in Word</span>
          </div>
          <div>
            <p class="eyebrow">Sample report</p>
            <h2 class="sample-h">{p.sample.title}</h2>
            <p class="lede">{p.sample.body}</p>
            <a class="btn mt-m" href={`/contact/?reason=sample&product=${slug}`}>
              Request a sample report <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <DesktopByDesign product={p.name} />

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-h">
    <div class="container split">
      <SectionHeader id="faq-h" eyebrow="FAQ" heading="Real concerns. *Honest answers.*">
        <a class="text-link" href="/faqs/">See every FAQ <span aria-hidden="true">→</span></a>
      </SectionHeader>
      <FaqList items={p.faqs} name={`${slug}-faq`} />
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section-tight surface-alt related" aria-labelledby="rel-h">
        <div class="container">
          <h2 id="rel-h" class="eyebrow">Also from Ledgerline</h2>
          <div class="related-grid">
            {related.map((r) => (
              <a class="related-card" href={`/${r.id}/`} style={`--hue: ${r.data.hue}`}>
                <ProductMark slug={r.id} />
                <span>
                  <span class="rc-name">{r.data.name}</span>
                  <span class="rc-desc">{plain(r.data.headline)}</span>
                </span>
                <span class="rc-price mono">from {r.data.fromPrice}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    heading={p.closing.heading}
    body={p.closing.body}
    primary={{ label: `Buy ${p.name}`, href: buyHref(slug) }}
    secondary={{ label: 'Book a demo', href: `/book-a-demo/?product=${slug}` }}
  />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-xl) var(--space-3xl);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 75% 20%, color-mix(in srgb, var(--hue, var(--accent)) 12%, transparent), transparent 60%),
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 100% 100%, 40px 40px, 40px 40px;
    opacity: 0.7;
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    margin-top: var(--space-l);
  }
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--space-2xl);
    }
  }
  .hero-kicker { display: flex; align-items: center; gap: 0.85rem; margin-bottom: var(--space-m); }
  .hero-name { display: block; font-weight: 700; font-size: var(--step-0); color: #ffffff; }
  .hero-name sup { font-size: 0.6em; opacity: 0.6; }
  .hero h1 { font-size: clamp(2.4rem, 1.5rem + 2.6vw, 4rem); font-weight: 800; }
  .hero h1 :global(em) { color: var(--hue, var(--accent)); }
  .hero .lede { margin-top: var(--space-m); }
  .hero-actions { margin-top: var(--space-l); }
  .hero-note { margin-top: var(--space-s); font-size: var(--step--2); color: var(--muted); }
  .audience { margin-top: var(--space-l); padding-top: var(--space-s); border-top: 1px solid var(--rule); font-size: var(--step--1); color: var(--muted); }
  .hero-plate { position: relative; }
  .hero-plate::before {
    content: '';
    position: absolute;
    inset: -2rem;
    background: radial-gradient(circle at 60% 40%, color-mix(in srgb, var(--hue, var(--accent)) 16%, transparent), transparent 70%);
    z-index: -1;
    filter: blur(20px);
  }

  .stat-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--rule);
    background: rgba(14, 20, 32, 0.4);
    border-radius: var(--radius-l);
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  @media (min-width: 48rem) { .stat-strip { grid-template-columns: repeat(4, 1fr); } }
  .stat-strip > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
    padding: var(--space-m) var(--space-l);
    background: rgba(10, 15, 24, 0.6);
  }
  .stat-strip > div + div { border-left: 1px solid var(--rule); }
  .stat-strip dd {
    margin: 0;
    font-size: var(--step-3);
    font-weight: 800;
    line-height: 1;
    color: #ffffff;
  }
  .stat-strip dt { font-size: var(--step--2); color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; font-family: var(--font-mono); }

  .rating { font-size: var(--step--2); color: var(--accent); font-weight: 600; }
  .quotes { columns: 1; column-gap: var(--space-m); }
  .quotes > :global(*) { margin-bottom: var(--space-m); }
  @media (min-width: 44rem) { .quotes { columns: 2; } }
  @media (min-width: 70rem) { .quotes { columns: 3; } }

  .prose-sm { color: var(--ink-2); max-width: 60ch; }
  .problem-side { display: grid; gap: var(--space-m); align-content: start; }
  .ledger {
    background: rgba(14, 20, 32, 0.85);
    backdrop-filter: blur(14px);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    overflow: hidden;
    font-size: var(--step--1);
  }
  .ledger th {
    text-align: left;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid var(--rule);
    background: rgba(255, 255, 255, 0.03);
    color: var(--muted);
  }
  .ledger td { padding: 0.9rem 1.1rem; border-bottom: 1px solid var(--rule-soft); vertical-align: top; width: 50%; color: var(--ink-2); }
  .ledger td:first-child { color: var(--muted); border-right: 1px solid var(--rule-soft); text-decoration: line-through; text-decoration-color: rgba(244, 63, 94, 0.5); }
  .ledger tr:last-child td { border-bottom: 0; }
  .neg { color: var(--negative); font-weight: bold; }
  .pos { color: var(--positive); font-weight: bold; }

  .ruled-top { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .features { display: grid; gap: var(--space-3xl); }
  .feature { display: grid; gap: var(--space-l); align-items: center; }
  @media (min-width: 60rem) {
    .feature { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-2xl); }
    .feature.flip { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .feature.flip .feature-copy { order: 2; }
  }
  .feature-copy { display: grid; gap: var(--space-s); color: var(--ink-2); }
  .feature-copy h3 { color: #ffffff; font-size: var(--step-3); font-weight: 700; }
  .kicker { font-size: var(--step--2); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--hue, var(--accent)); }
  .feature-figure { display: flex; align-items: baseline; gap: 0.75rem; margin-top: var(--space-xs); padding-top: var(--space-s); border-top: 1px solid var(--rule); color: var(--muted); font-size: var(--step--1); }
  .feature-figure .figure-num { font-size: var(--step-3); color: #ffffff; }

  .feature-cards { display: grid; gap: var(--space-m); margin-top: var(--space-3xl); }
  @media (min-width: 48rem) { .feature-cards { grid-template-columns: repeat(2, 1fr); } }
  .feature-card {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    padding: var(--space-l);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 3px solid var(--hue, var(--accent));
    border-radius: var(--radius-l);
    background: rgba(14, 20, 32, 0.8);
    backdrop-filter: blur(12px);
    color: var(--ink-2);
  }
  .feature-card h3 { color: #ffffff; font-weight: 700; }
  .card-figure { font-size: var(--step-5); font-weight: 800; line-height: 1; color: #ffffff; }

  .questions { display: grid; gap: 0; border-top: 1px solid var(--rule); }
  @media (min-width: 48rem) { .questions { grid-template-columns: 1fr 1fr; column-gap: var(--space-xl); } }
  .questions li { display: flex; gap: var(--space-m); padding-block: var(--space-m); border-bottom: 1px solid var(--rule); font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; line-height: 1.35; color: #ffffff; }
  .qn { color: var(--accent); font-size: var(--step--1); padding-top: 0.25rem; }

  .steps { display: grid; gap: var(--space-l); counter-reset: step; }
  @media (min-width: 48rem) { .steps { grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); } }
  .step { display: grid; gap: var(--space-xs); align-content: start; padding-top: var(--space-m); border-top: 2px solid var(--hue, var(--accent)); color: var(--ink-2); }
  .step h3 { color: #ffffff; font-size: var(--step-2); font-weight: 700; }
  .step-n { font-size: var(--step--1); font-weight: 700; color: var(--hue, var(--accent)); }

  .audience-grid {
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    overflow: hidden;
  }
  @media (min-width: 48rem) { .audience-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 72rem) { .audience-grid:has(> :nth-child(3):last-child) { grid-template-columns: repeat(3, 1fr); } }
  .aud { background: #090e18; padding: var(--space-l); display: grid; gap: var(--space-xs); align-content: start; }
  .aud h3 { font-size: var(--step-2); font-weight: 700; color: #ffffff; }
  .aud p { color: var(--muted); }
  .note {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-m);
    margin-top: var(--space-m);
    padding: var(--space-m) var(--space-l);
    border: 1px solid var(--rule);
    background: rgba(14, 20, 32, 0.6);
    border-radius: var(--radius-l);
  }
  .note h3 { font-family: var(--font-sans); font-weight: 600; font-size: var(--step-0); color: #ffffff; }
  .note p { color: var(--muted); font-size: var(--step--1); max-width: 60ch; }

  .plans { display: grid; gap: var(--space-m); align-items: stretch; }
  @media (min-width: 56rem) {
    .plans.n1 { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); }
    .plans.n2 { grid-template-columns: repeat(2, minmax(0, 24rem)); }
    .plans.n3 { grid-template-columns: repeat(3, 1fr); }
  }
  .includes { display: grid; gap: var(--space-m); align-content: start; padding: var(--space-l); }
  .includes h3 { font-family: var(--font-sans); font-weight: 600; font-size: var(--step-0); color: #ffffff; }
  .includes p { color: var(--ink-2); font-size: var(--step--1); }
  .guarantee {
    display: flex;
    gap: var(--space-m);
    align-items: center;
    margin-top: var(--space-l);
    padding: var(--space-m);
    background: rgba(14, 20, 32, 0.7);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
  }
  .guarantee h3 { font-family: var(--font-sans); font-weight: 600; font-size: var(--step-0); color: #ffffff; }
  .guarantee p { color: var(--muted); font-size: var(--step--1); max-width: 80ch; }
  .seal {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 4.25rem;
    block-size: 4.25rem;
    border-radius: 50%;
    border: 1.5px solid var(--positive);
    color: var(--positive);
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 0.9;
