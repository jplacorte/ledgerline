---
import { initials } from '../lib/text';

interface Props {
  quote: string;
  name: string;
  role?: string;
  tag?: string;
  size?: 'md' | 'lg';
}
const { quote, name, role, tag, size = 'md' } = Astro.props;
---

<figure class:list={['quote', size]}>
  {tag && <p class="tag"><span class="dot"></span>{tag}</p>}
  <blockquote><p>“{quote}”</p></blockquote>
  <figcaption>
    <span class="avatar mono" aria-hidden="true">{initials(name)}</span>
    <span><span class="name">{name}</span>{role && <span class="role">{role}</span>}</span>
  </figcaption>
</figure>

<style>
  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin: 0;
    padding: var(--space-m);
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    break-inside: avoid;
  }
  blockquote { font-family: var(--font-display); font-size: 1.2rem; line-height: 1.45; color: var(--ink); }
  .lg blockquote { font-size: var(--step-2); line-height: 1.3; }
  figcaption { display: flex; align-items: center; gap: 0.75rem; margin-top: auto; font-size: var(--step--1); }
  .avatar {
    display: grid; place-items: center; flex: none;
    inline-size: 2.25rem; block-size: 2.25rem; border-radius: 50%;
    background: var(--paper-2); border: 1px solid var(--rule);
    font-size: 0.7rem; color: var(--ink-2);
  }
  .name { display: block; font-weight: 600; }
  .role { display: block; color: var(--muted); font-size: var(--step--2); }
  :global(.surface-night) .quote { background: var(--night-2); }
  :global(.surface-night) blockquote { color: var(--night-text); }
  :global(.surface-night) .avatar { background: var(--night); color: var(--night-text); }
</style>
