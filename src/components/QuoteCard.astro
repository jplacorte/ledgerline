---
import { initials } from '../lib/text';

interface Props {
  quote: string;
  name: string;
  role?: string;
  tag?: string;
  size?: 'md' | 'lg';
}
const { quote, name, role, tag, size = 'md' } = Astro.props;
---

<figure class:list={['quote', size]}>
  {tag && <p class="tag"><span class="dot"></span>{tag}</p>}
  <blockquote><p>“{quote}”</p></blockquote>
  <figcaption>
    <span class="avatar mono" aria-hidden="true">{initials(name)}</span>
    <span><span class="name">{name}</span>{role && <span class="role">{role}</span>}</span>
  </figcaption>
</figure>

<style>
  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin: 0;
    padding: var(--space-m);
    background: rgba(16, 22, 35, 0.75);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-card);
    break-inside: avoid;
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .quote:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.8);
  }
  blockquote {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--ink);
    font-weight: 500;
  }
  .lg blockquote { font-size: var(--step-2); line-height: 1.35; }
  figcaption { display: flex; align-items: center; gap: 0.75rem; margin-top: auto; font-size: var(--step--1); padding-top: var(--space-xs); border-top: 1px solid var(--rule-soft); }
  .avatar {
    display: grid; place-items: center; flex: none;
    inline-size: 2.25rem; block-size: 2.25rem; border-radius: 50%;
    background: linear-gradient(135deg, rgba(0, 240, 160, 0.15) 0%, rgba(56, 189, 248, 0.15) 100%);
    border: 1px solid rgba(0, 240, 160, 0.3);
    font-size: 0.72rem; color: var(--accent); font-weight: 700;
    box-shadow: 0 0 10px rgba(0, 240, 160, 0.2);
  }
  .name { display: block; font-weight: 600; color: #f8fafc; }
  .role { display: block; color: var(--muted); font-size: var(--step--2); }
</style>
