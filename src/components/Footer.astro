---
import Wordmark from './Wordmark.astro';
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
const columns = {
  Software: nav.products,
  Data: nav.data,
  ...nav.footer,
};
---

<footer class="site-footer surface-night">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" aria-label={`${site.name} home`} class="brand-link"><Wordmark tone="light" /></a>
        <p class="footer-tag">{site.tagline}</p>
        <dl class="footer-contact">
          <div><dt>Sales &amp; support</dt><dd><a href={site.phoneHref} class="mono">{site.phone}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${site.email.support}`}>{site.email.support}</a></dd></div>
          <div><dt>Hours</dt><dd>{site.hours}</dd></div>
        </dl>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        {
          Object.entries(columns).map(([heading, links]) => (
            <div>
              <h2 class="col-head mono">{heading}</h2>
              <ul role="list">
                {links.map((link) => (
                  <li><a href={link.href}>{link.label}</a></li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <div class="footer-bottom">
      <p>© {year} {site.name}. Trusted by financial professionals since {site.founded}.</p>
      <p class="mono">Desktop by design · {site.location}</p>
    </div>
    <p class="demo-note">{site.demoNotice}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-2xl) var(--space-l);
    font-size: var(--step--1);
    background: #04060a;
    border-top: 1px solid var(--rule);
  }
  .footer-top {
    display: grid;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 60rem) { .footer-top { grid-template-columns: 1fr 2fr; } }
  .brand-link { text-decoration: none; color: var(--ink); }
  .footer-tag {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    margin-top: var(--space-m);
    background: linear-gradient(135deg, #ffffff 0%, var(--muted) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .footer-contact { margin-top: var(--space-l); display: grid; gap: 0.85rem; }
  .footer-contact dt { font-family: var(--font-mono); font-size: var(--step--2); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .footer-contact dd { margin: 0.15rem 0 0; color: var(--ink); }
  .footer-nav { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-l) var(--space-m); }
  @media (min-width: 40rem) { .footer-nav { grid-template-columns: repeat(4, 1fr); } }
  .col-head { font-size: var(--step--2); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: var(--space-s); }
  .footer-nav ul { display: grid; gap: 0.65rem; }
  a { color: var(--muted); text-decoration: none; transition: color 0.18s var(--ease); }
  a:hover { color: var(--accent); }
  .demo-note { margin-top: var(--space-s); font-size: var(--step--2); color: var(--muted); opacity: 0.7; }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    padding-top: var(--space-m);
    color: var(--muted);
    font-size: var(--step--2);
  }
</style>
