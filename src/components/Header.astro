---
import ProductMark from './ProductMark.astro';
import Wordmark from './Wordmark.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const productPaths = [...nav.products, ...nav.data].map((l) => l.href);
const inProducts = productPaths.includes(path);
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<div class="topbar">
  <div class="container topbar-inner">
    <p>
      <span class="mono">EST. {site.founded}</span>
      <span class="sep" aria-hidden="true"></span>
      Desktop software for financial professionals
    </p>
    <p class="topbar-right">
      <span>US-based support</span>
      <a href={site.phoneHref} class="mono">{site.phone}</a>
    </p>
  </div>
</div>

<header class="site-header" data-header>
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${site.name} home`}><Wordmark /></a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="sr-only">Menu</span>
      <span class="burger" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <ul role="list" class="nav-list">
        <li class="has-panel">
          <button
            type="button"
            class:list={['nav-link', 'panel-trigger', { current: inProducts }]}
            aria-expanded="false"
            aria-controls="products-panel"
            data-panel-trigger
          >
            Products
            <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
          </button>
          <div class="panel" id="products-panel" data-panel>
            <div class="panel-col">
              <p class="panel-label mono">Software</p>
              <ul role="list" class="panel-grid">
                {
                  nav.products.map((item) => (
                    <li>
                      <a href={item.href} class="panel-item" aria-current={path === item.href ? 'page' : undefined}>
                        <ProductMark slug={item.href.replaceAll('/', '')} />
                        <span>
                          <span class="pi-title">{item.label}</span>
                          <span class="pi-desc">{item.description}</span>
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="panel-col panel-aside">
              <p class="panel-label mono">Data</p>
              <ul role="list" class="panel-grid one">
                {
                  nav.data.map((item) => (
                    <li>
                      <a href={item.href} class="panel-item" aria-current={path === item.href ? 'page' : undefined}>
                        <ProductMark slug={item.href.replaceAll('/', '')} />
                        <span>
                          <span class="pi-title">{item.label}</span>
                          <span class="pi-desc">{item.description}</span>
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
              <a href="/pricing/" class="text-link panel-cta">Compare all pricing <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </li>
        {
          nav.main.map((item) => (
            <li>
              <a href={item.href} class:list={['nav-link', { current: isCurrent(item.href) }]} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav-actions">
        <a href="/contact/" class="btn btn-ghost btn-sm">Contact</a>
        <a href="/book-a-demo/" class="btn btn-accent btn-sm">Book a demo</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuToggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const trigger = header?.querySelector<HTMLButtonElement>('[data-panel-trigger]');
  const panel = header?.querySelector<HTMLElement>('[data-panel]');

  const setPanel = (open: boolean) => {
    trigger?.setAttribute('aria-expanded', String(open));
    panel?.toggleAttribute('data-open', open);
  };
  const setMenu = (open: boolean) => {
    if (open && header) header.style.setProperty('--header-offset', `${header.getBoundingClientRect().bottom}px`);
    menuToggle?.setAttribute('aria-expanded', String(open));
    header?.toggleAttribute('data-menu-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };

  trigger?.addEventListener('click', () => setPanel(trigger.getAttribute('aria-expanded') !== 'true'));
  menuToggle?.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (trigger?.getAttribute('aria-expanded') === 'true') {
      setPanel(false);
      trigger.focus();
    } else if (menuToggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuToggle.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Node)) return;
    if (trigger?.getAttribute('aria-expanded') === 'true' && !trigger.parentElement?.contains(e.target)) setPanel(false);
  });
  // Close the desktop panel once focus leaves it.
  trigger?.parentElement?.addEventListener('focusout', (e) => {
    const next = e.relatedTarget;
    if (window.matchMedia('(min-width: 64rem)').matches && next instanceof Node && !trigger.parentElement?.contains(next)) setPanel(false);
  });
  window.matchMedia('(min-width: 64rem)').addEventListener('change', () => setMenu(false));
</script>

<style>
  .topbar {
    background: var(--night);
    color: var(--night-muted);
    font-size: var(--step--2);
  }
  .topbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s);
    min-height: 2.25rem;
  }
  .topbar p { display: flex; align-items: center; gap: 0.75rem; }
  .topbar .sep { inline-size: 1px; block-size: 0.8rem; background: var(--night-rule); }
  .topbar a { color: var(--night-text); text-decoration: none; }
  .topbar a:hover { color: #f08a5a; }
  @media (max-width: 40rem) {
    .topbar-inner > p:first-child { display: none; }
    .topbar-inner { justify-content: center; }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: 4.25rem;
  }
  .brand { text-decoration: none; color: var(--ink); margin-right: auto; }

  .site-nav { display: flex; align-items: center; gap: var(--space-m); }
  .nav-list { display: flex; align-items: center; gap: 0.25rem; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.75rem;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    background: none;
    border: 0;
    border-radius: var(--radius);
  }
  .nav-link:hover, .panel-trigger[aria-expanded='true'] { color: var(--ink); background: var(--paper-2); }
  .nav-link.current { color: var(--ink); box-shadow: inset 0 -2px 0 var(--accent); border-radius: 0; }
  .chev { inline-size: 0.75rem; transition: transform 0.2s var(--ease); }
  .panel-trigger[aria-expanded='true'] .chev { transform: rotate(180deg); }
  .nav-actions { display: flex; gap: 0.5rem; }

  .has-panel { position: relative; }
  .panel {
    display: none;
    position: absolute;
    top: calc(100% + 0.9rem);
    left: -1rem;
    inline-size: min(52rem, 90vw);
    grid-template-columns: 1.6fr 1fr;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-plate);
    overflow: hidden;
  }
  .panel[data-open] { display: grid; animation: drop 0.18s var(--ease); }
  @keyframes drop { from { opacity: 0; transform: translateY(-6px); } }
  .panel-col { padding: var(--space-m); }
  .panel-aside { background: var(--paper); border-left: 1px solid var(--rule); display: flex; flex-direction: column; }
  .panel-label { font-size: var(--step--2); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.75rem; }
  .panel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem; }
  .panel-grid.one { grid-template-columns: 1fr; }
  .panel-item {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 0.75rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
  }
  .panel-item:hover, .panel-item[aria-current='page'] { background: var(--paper-2); color: var(--ink); }
  .pi-title { display: block; font-weight: 600; font-size: var(--step--1); line-height: 1.3; }
  .pi-desc { display: block; font-size: var(--step--2); color: var(--muted); margin-top: 0.15rem; line-height: 1.4; }
  .panel-cta { margin-top: auto; align-self: flex-start; }

  .menu-toggle {
    display: none;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    place-items: center;
    background: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .burger, .burger::before, .burger::after {
    display: block;
    inline-size: 1.1rem;
    block-size: 1.5px;
    background: var(--ink);
    transition: transform 0.2s var(--ease), opacity 0.2s;
  }
  .burger { position: relative; }
  .burger::before, .burger::after { content: ''; position: absolute; left: 0; }
  .burger::before { top: -6px; }
  .burger::after { top: 6px; }
  [data-menu-open] .burger { background: transparent; }
  [data-menu-open] .burger::before { transform: translateY(6px) rotate(45deg); }
  [data-menu-open] .burger::after { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 63.99rem) {
    .menu-toggle { display: grid; }
    .site-nav {
      display: none;
      /* absolute, not fixed: the header's backdrop-filter is a containing block for fixed children */
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      block-size: calc(100dvh - var(--header-offset, 6.5rem));
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-m);
      padding: var(--space-m) var(--gutter) var(--space-xl);
      background: var(--paper);
      border-top: 1px solid var(--rule);
      overflow-y: auto;
    }
    [data-menu-open] .site-nav { display: flex; }
    .nav-list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav-list > li { border-bottom: 1px solid var(--rule); }
    .nav-link { inline-size: 100%; justify-content: space-between; padding: 1rem 0; font-size: var(--step-1); font-family: var(--font-display); border-radius: 0; }
    .nav-link:hover, .panel-trigger[aria-expanded='true'] { background: none; }
    .nav-link.current { box-shadow: none; color: var(--accent-ink); }
    .panel { position: static; inline-size: auto; box-shadow: none; border: 0; grid-template-columns: 1fr; background: transparent; margin-bottom: var(--space-s); }
    .panel-col { padding: 0; }
    .panel-aside { background: transparent; border: 0; margin-top: var(--space-s); }
    .panel-grid { grid-template-columns: 1fr; }
    .panel-item { padding-inline: 0; }
    .panel-cta { margin-top: var(--space-s); }
    .nav-actions { flex-direction: column; }
    .nav-actions .btn { min-height: 3rem; }
  }
</style>
