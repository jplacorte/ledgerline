---
interface Props {
  items: { q: string; a: string }[];
  name?: string;
}
const { items, name } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details name={name}>
        <summary>
          <span>{item.q}</span>
          <span class="icon" aria-hidden="true" />
        </summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq { border-top: 1px solid var(--rule); }
  details { border-bottom: 1px solid var(--rule); }
  summary {
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: 1.2rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--accent-ink); }
  .icon { position: relative; flex: none; inline-size: 1rem; block-size: 1rem; margin-top: 0.3rem; }
  .icon::before, .icon::after { content: ''; position: absolute; inset: 50% 0 auto; block-size: 1.5px; background: currentColor; transition: transform 0.25s var(--ease); }
  .icon::after { transform: rotate(90deg); }
  details[open] .icon::after { transform: rotate(0); }
  details p { padding-bottom: 1.4rem; max-width: 68ch; color: var(--ink-2); }
  :global(.surface-night) details p { color: var(--night-muted); }
  @media (prefers-reduced-motion: no-preference) {
    details::details-content { transition: content-visibility 0.3s allow-discrete, block-size 0.3s var(--ease); block-size: 0; overflow: clip; }
    details[open]::details-content { block-size: auto; }
  }
</style>
