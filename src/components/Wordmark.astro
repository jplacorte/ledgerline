---
/**
 * Ledgerline logo: an "L" whose foot is the orange bottom line, with ledger rows ruled beside the stem.
 * The same geometry is used in public/favicon.svg and scripts/og-image.mjs.
 */
interface Props {
  tone?: 'ink' | 'light';
}
const { tone = 'ink' } = Astro.props;
---

<span class:list={['wordmark', tone]}>
  <span class="glyph" aria-hidden="true">
    <svg viewBox="0 0 64 64">
      <rect class="tile" width="64" height="64" rx="14"></rect>
      <rect class="stem" x="16" y="13" width="7" height="31" rx="1"></rect>
      <rect class="row" x="28" y="16" width="20" height="2.5" rx="1.25" opacity="0.9"></rect>
      <rect class="row" x="28" y="24" width="16" height="2.5" rx="1.25" opacity="0.65"></rect>
      <rect class="row" x="28" y="32" width="12" height="2.5" rx="1.25" opacity="0.4"></rect>
      <rect class="base" x="16" y="44" width="32" height="7" rx="1"></rect>
    </svg>
  </span>
  <span class="name">Ledger<em>line</em></span>
</span>

<style>
  .wordmark { display: inline-flex; align-items: center; gap: 0.65rem; }
  .glyph svg {
    inline-size: 2rem;
    block-size: 2rem;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.6));
  }
  .tile {
    fill: #151c2e;
    stroke: rgba(255, 255, 255, 0.14);
    stroke-width: 1px;
  }
  .stem, .row { fill: #f8fafc; }
  .base {
    fill: var(--accent);
    filter: drop-shadow(0 0 4px var(--accent));
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--ink);
  }
  .name em {
    font-style: normal;
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent) 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    padding-left: 1px;
  }
  .light .tile { fill: #101626; stroke: rgba(255, 255, 255, 0.15); }
  .light .stem, .light .row { fill: #f8fafc; }
  .light .base { fill: var(--accent); }
  .light .name { color: #f8fafc; }
</style>
