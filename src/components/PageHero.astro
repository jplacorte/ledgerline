---
import Breadcrumbs from './Breadcrumbs.astro';
import { emph } from '../lib/text';

interface Props {
  crumbs: { label: string; href?: string }[];
  eyebrow?: string;
  heading: string;
  lede?: string;
  tone?: 'paper' | 'night';
}
const { crumbs, eyebrow, heading, lede, tone = 'paper' } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['page-hero', { 'surface-night': tone === 'night' }]}>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <div class:list={['ph-grid', { 'has-aside': hasAside }]}>
      <div class="ph-copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 set:html={emph(heading)} />
        {lede && <p class="lede">{lede}</p>}
        <slot />
      </div>
      {hasAside && <div class="ph-aside"><slot name="aside" /></div>}
    </div>
  </div>
</section>

<style>
  .page-hero { padding-block: var(--space-l) var(--space-2xl); border-bottom: 1px solid var(--rule); }
  .ph-grid { display: grid; gap: var(--space-xl); align-items: end; margin-top: var(--space-xl); }
  @media (min-width: 64rem) { .ph-grid.has-aside { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
  .ph-copy { display: grid; gap: var(--space-m); justify-items: start; }
  h1 { font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.6rem); max-width: 16ch; }
</style>
